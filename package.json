{
  "name": "crashbox",
  "private": false,
  "version": "0.1.0",
  "description": "Local-first crash black box for the browser: survives hard tab kills (WebGPU, WASM, OOM) and surfaces the recovered state on next load.",
  "license": "MIT",
  "author": "Ryan Roemer <ryan.roemer@nearform.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nearform/crashbox.git"
  },
  "homepage": "https://github.com/nearform/crashbox#readme",
  "bugs": {
    "url": "https://github.com/nearform/crashbox/issues"
  },
  "keywords": [
    "webgpu",
    "webassembly",
    "wasm",
    "crash reporting",
    "crash recovery",
    "error recovery",
    "oom",
    "out-of-memory",
    "ios",
    "safari",
    "breadcrumbs",
    "local-first",
    "black box",
    "tab crash"
  ],
  "type": "module",
  "main": "src/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc --project tsconfig.json",
    "prepack": "npm run build",
    "check": "npm run lint && npm run check:types && npm run check:format && npm run test",
    "check:format": "prettier --check .",
    "check:lint": "eslint .",
    "check:types": "tsc --project tsconfig.check.json",
    "format": "prettier --write . && eslint --cache --fix .",
    "lint": "eslint .",
    "test": "node --test 'test/*.test.js'",
    "test:only": "node --test --test-only 'test/*.test.js'",
    "dep:check": "npx npm-check-updates"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.2",
    "@webgpu/types": "^0.1.70",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "happy-dom": "^20.10.2",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
